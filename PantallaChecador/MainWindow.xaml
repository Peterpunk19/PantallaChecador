<Window x:Class="PantallaChecador.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PantallaChecador"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        Title="MainWindow" Height="1080" Width="1920" Closed="Window_Closed" Loaded="Window_Loaded" Icon="Resources/huella-dactilar.png" >
    <Grid Background="#FF174276">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="1620"/>
            <ColumnDefinition Width="50*"/>
        </Grid.ColumnDefinitions>

        <Image 
        Grid.Column="1" 
        x:Name="imgPerfil" 
        Height="400" 
        Width="400"
        Margin="0,200,1100,0" 
        VerticalAlignment="Top" 
        HorizontalAlignment="Right"             
        Source="Resources/huella-dactilar2.jpg" 
        Stretch="Uniform" />
        <Label x:Name="lblHora" Content="Hora:" Foreground="#FF0078D4" FontSize="60" Height="88" Margin="1320,123,0,0" VerticalAlignment="Top" Grid.Column="1" HorizontalAlignment="Left" Width="175" FontWeight="Bold" Background="White" Grid.ColumnSpan="2" Visibility="Hidden"/>
        <Label x:Name="lblWelcome" Content="¡Bienvenido!" HorizontalAlignment="Right" Foreground="White" FontSize="60" Height="90" Margin="0,20,504,0" VerticalAlignment="Top" Grid.Column="1" Width="542"/>
        <Label x:Name="lblMessage" Content="Coloca tu dedo en el lector" HorizontalAlignment="Right" Foreground="#FFF" FontSize="50" Height="90" Margin="0,366,70,0" VerticalAlignment="Top" Grid.Column="1"  Width="800" FontWeight="Medium"/>
        <Label x:Name="lblEmployeeName" Content="Nombre:"  Visibility="Hidden" HorizontalAlignment="Right" Foreground="#0078d4" FontSize="60" Height="90" Margin="0,175,4,0" VerticalAlignment="Top" Grid.Column="1" Width="1026"/>
        <Label x:Name="lblFirstName"  Content="" HorizontalAlignment="Right" Foreground="#FFF" FontSize="60" Height="90" Margin="0,245,4,0" VerticalAlignment="Top" Grid.Column="1" Width="1026"/>
        <Label x:Name="lblLastName" Content="" HorizontalAlignment="Right" Foreground="#FFF" FontSize="60" Height="90" Margin="0,325,4,0" VerticalAlignment="Top" Grid.Column="1"  Width="1026"/>
        <Label x:Name="lblArea" Content="" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#FFF" FontSize="40" Height="90" Margin="0,420,4,0" VerticalAlignment="Top" Grid.Column="1"  Width="1026" />
        <Label x:Name="lblActive" Content="" Foreground="WHITE" FontSize="40" Height="73" Margin="0,520,4,0" VerticalAlignment="Top" Grid.Column="1" HorizontalAlignment="Right" Width="1026"/>

        <Label x:Name="lblStatus" 
               Margin="140,0,680,52" Grid.Column="1" Foreground="White" Height="72" VerticalAlignment="Bottom" FontSize="36"/>
        <Label x:Name="lblReport" Margin="780,0,65,52" Grid.Column="1" Foreground="White" Height="72" VerticalAlignment="Bottom" FontSize="36" Grid.ColumnSpan="2"/>
        <Label x:Name="lblWebcam" Content="" Margin="140,0,680,5" Grid.Column="1" Foreground="White" Height="72" VerticalAlignment="Bottom" FontSize="36"/>
        <Border x:Name="alertContainer" Grid.Column="1" Visibility="Collapsed" Background="#FFD32F2F" CornerRadius="5"
        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="558,700,0,0"
        Padding="10" Width="1036" Grid.ColumnSpan="2" >
            <TextBlock x:Name="alertTextBlock" Text="This is an alert message!" Foreground="White" FontSize="40" FontWeight="Bold" Margin="-10,0,10,0"  Padding="10,0,0,0" />
        </Border>
        <Label 
            x:Name="lblAssistanceCode"
            Content="Ingresa tu código de asistencia" HorizontalAlignment="Left" 
            Margin="44,604,0,0" 
            VerticalAlignment="Top" 
            Foreground="White"
            FontSize="42" Grid.Column="1" FontWeight="Bold"/>
        <TextBox             
            x:Name="txtAssistanceCode"           
            Grid.Column="1"
            HorizontalAlignment="Left" 
            Margin="178,692,0,0" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            FontSize="80"
            FontWeight="Bold"
            MaxLength="6"
            Width="290"
            Height="110"
            LostFocus="txtAssistanceCode_LostFocus" 
            PreviewTextInput="txtAssistanceCode_PreviewTextInput"
            DataObject.Pasting="txtAssistanceCode_Pasting"
            />

    </Grid>
</Window>
